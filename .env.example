# Copy this file to .env (optional). Everything has a safe default for local use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Secret admin address. Open it as http://127.0.0.1:8000/<this value>/
ADMIN_URL=control-room-mk
# Optional: get contact messages in your Gmail too (use a Gmail App Password)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
